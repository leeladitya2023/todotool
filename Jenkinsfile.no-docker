// Jenkinsfile without Docker - Pure CI/CD for React app
// Use this if you don't want to use Docker at all

pipeline {
    agent any
    
    environment {
        // Application configuration
        APP_NAME = 'todo-reduxtoolkit'
        BUILD_DIR = 'dist'
        NODE_VERSION = '18' // Change if needed
        
        // Optional: If you want to deploy to a server
        DEPLOY_HOST = '' // Leave empty if no deployment
        DEPLOY_USER = 'deploy'
        DEPLOY_PATH = '/var/www/todo-app' // Path on server where app will be deployed
        DEPLOY_SSH_CREDENTIALS = 'ssh-credentials' // Jenkins credential ID
    }
    
    stages {
        stage('Checkout') {
            steps {
                script {
                    echo "Checking out code from repository..."
                    checkout scm
                }
            }
        }
        
        stage('Setup Node.js') {
            steps {
                script {
                    echo "Setting up Node.js ${NODE_VERSION}..."
                    // Install Node.js if using Jenkins agent with NodeJS plugin
                    // sh 'nvm use ${NODE_VERSION}' // If nvm is available
                    sh 'node --version'
                    sh 'npm --version'
                }
            }
        }
        
        stage('Install Dependencies') {
            steps {
                script {
                    echo "Installing dependencies..."
                    sh '''
                        cd REACT/11todoReduxToolkit
                        npm ci
                    '''
                }
            }
        }
        
        stage('Lint') {
            steps {
                script {
                    echo "Running ESLint..."
                    sh '''
                        cd REACT/11todoReduxToolkit
                        npm run lint || true
                    '''
                }
            }
        }
        
        stage('Test') {
            steps {
                script {
                    echo "Running tests..."
                    sh '''
                        cd REACT/11todoReduxToolkit
                        npm test -- --coverage --watchAll=false || true
                    '''
                }
            }
            post {
                always {
                    // Publish test results if available
                    publishHTML([
                        reportDir: 'REACT/11todoReduxToolkit/coverage',
                        reportFiles: 'index.html',
                        reportName: 'Test Coverage Report',
                        allowMissing: true
                    ])
                }
            }
        }
        
        stage('Build Application') {
            steps {
                script {
                    echo "Building React application..."
                    sh '''
                        cd REACT/11todoReduxToolkit
                        npm run build
                    '''
                }
            }
            post {
                success {
                    echo "Build successful! Artifacts saved."
                    // Archive the built files
                    archiveArtifacts artifacts: 'REACT/11todoReduxToolkit/dist/**/*', fingerprint: true
                }
            }
        }
        
        stage('Deploy to Server') {
            when {
                // Only deploy if DEPLOY_HOST is set
                expression { env.DEPLOY_HOST != '' }
                branch 'main' // Change to 'master' if needed
            }
            steps {
                script {
                    echo "Deploying to ${DEPLOY_HOST}..."
                    sshagent([env.DEPLOY_SSH_CREDENTIALS]) {
                        sh '''
                            # Create deployment directory
                            ssh -o StrictHostKeyChecking=no ${DEPLOY_USER}@${DEPLOY_HOST} \
                                "mkdir -p ${DEPLOY_PATH}"
                            
                            # Copy built files to server
                            scp -r -o StrictHostKeyChecking=no \
                                REACT/11todoReduxToolkit/dist/* \
                                ${DEPLOY_USER}@${DEPLOY_HOST}:${DEPLOY_PATH}/
                            
                            echo "Deployment completed!"
                        '''
                    }
                }
            }
        }
    }
    
    post {
        always {
            script {
                echo "Cleaning up workspace..."
                // Clean npm cache if needed
                sh 'npm cache clean --force || true'
            }
        }
        success {
            echo "✅ Pipeline completed successfully!"
            if (env.DEPLOY_HOST != '') {
                echo "🌐 Application deployed to: http://${DEPLOY_HOST}"
            } else {
                echo "📦 Build artifacts archived. Check build artifacts above."
            }
        }
        failure {
            echo "❌ Pipeline failed! Check logs above."
        }
        cleanup {
            cleanWs()
        }
    }
}

